{
  "name": "phmon-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11 <25"
  },
  "scripts": {
    "dev": "nuxt dev --host 0.0.0.0 --port 3005 --dotenv ../.env",
    "build": "nuxt build",
    "start": "node .output/server/index.mjs",
    "test:unit": "node --experimental-strip-types --test tests/*.test.ts",
    "export:assets": "node scripts/export-assets.mjs",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@iconify-json/lucide": "1.2.137",
    "@nuxt/ui": "4.11.2",
    "chart.js": "4.5.1",
    "h3": "1.15.11",
    "leaflet": "^1.9.4",
    "nuxt": "4.5.2",
    "qrcode.vue": "3.9.1",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.17.0",
    "@types/leaflet": "^1.9.22",
    "@types/ws": "^8.18.1",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "vue-tsc": "3.3.11"
  }
}
