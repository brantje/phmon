# Development only. Never reuse this password outside your local machine.
POSTGRES_USER=phmon
POSTGRES_PASSWORD=phmon_local_only
POSTGRES_DB=phmon
POSTGRES_PORT=5435
SERVER_PORT=8081
# Agent WebSocket/API bind. Keep loopback unless trusted development explicitly needs LAN access.
SERVER_BIND_ADDR=127.0.0.1
WEB_PORT=3005
# LAN access for the web UI. Set to 127.0.0.1 to restrict it to this machine.
WEB_BIND_ADDR=0.0.0.0
# Host-run server. Compose supplies its own container address and database URL.
HTTP_ADDR=127.0.0.1:8081
DATABASE_URL=postgres://phmon:phmon_local_only@127.0.0.1:5435/phmon?sslmode=disable
# Private Nuxt server configuration. Compose uses http://server:8081 instead.
NUXT_BACKEND_URL=http://127.0.0.1:8081
# Optional browser-facing URL used by the mobile-access QR/copy panel.
NUXT_PUBLIC_INSTANCE_URL=

# Slice 3 operator control-plane authentication. Development value only; generate a
# high-entropy secret for every real deployment and never reuse this example.
OPERATOR_ACCESS_SECRET=phmon-local-development-operator-secret-change-me-2026
OPERATOR_SESSION_COOKIE=phmon_operator
OPERATOR_ALLOWED_ORIGINS=http://127.0.0.1:3005,http://localhost:3005,http://127.0.0.1:3006,http://localhost:3006
OPERATOR_ALLOW_INSECURE_LOOPBACK=true
NUXT_OPERATOR_COOKIE_NAME=phmon_operator
